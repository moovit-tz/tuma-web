# /root/newapps-deploy/infra/tuma.env on the Hudumika box. Never commit the real file.
NODE_ENV=production
APP_URL=https://tuma.hudumika.tz
DATABASE_URL=postgres://tuma:<TUMA_DB_PASSWORD>@tuma-postgres:5432/tuma
SESSION_SECRET=<openssl rand -hex 32>

# Live Ondi. Client from POST /v1/clients/register (deploy/register-ondi-client.sh fills these in).
ONDI_MODE=oidc
ONDI_API_URL=https://ondi.hudumika.tz
ONDI_WEB_URL=https://ondi.hudumika.tz
ONDI_CLIENT_ID=
ONDI_CLIENT_SECRET=
ONDI_STUB_SECRET=unused-in-oidc-mode
# Must match ondi-api's own ADMIN_KEY (services/ondi-api/src/lib/env.ts) — gates POST
# /v1/organizations/provision, which every approved Tuma business is synced into Ondi through
# (see src/server/adapters/ondi-organizations.ts) so it shows up as this person's company in
# any other Hudumika product reading GET /v1/organizations/mine (e.g. CRM by Hudumika).
ONDI_ADMIN_KEY=

# Tuma app sign-in returns to the app on this scheme.
TUMAX_REDIRECT_URIS=tumax://auth

# ComplyOS stays on the reviewer stand-in (/dev/complyos, kyb.review only) until the profile integration lands.
COMPLYOS_MODE=stub
COMPLYOS_WEBHOOK_SECRET=<openssl rand -hex 24>
# Company lookup (BRELA) through ComplyOS. Unset = the Hudumika registry lookup on Ondi (ONDI_API_URL).
COMPLYOS_API_URL=
COMPLYOS_API_TOKEN=
AGENT_COMMISSION_BPS=1000
BLISS_WEBHOOK_SECRET=<openssl rand -hex 24>

# Hudumika Reference Number Service (parcel, cargo and case numbers like AAB204).
# local = run the allocator in Tuma's own database (default, until the shared service is live)
# http  = call the shared service
REFERENCE_MODE=local
REFERENCE_API_URL=
REFERENCE_API_TOKEN=

# Google Maps Platform (Places, Geocoding, Directions), called by the server for the app and cached in Redis.
# Restrict this key to those APIs and the server's IP in Google Cloud.
GOOGLE_MAPS_API_KEY=
REDIS_URL=redis://tuma-redis:6379

# HuduPay (mobile money push collections). Provision Tuma as a client with hudupay-api's
# scripts/provision-client.ts (callback URL https://tuma.hudumika.tz/api/hooks/hudupay); it prints the key and secret.
HUDUPAY_URL=
HUDUPAY_SERVICE_KEY=
HUDUPAY_CALLBACK_SECRET=

# CRM by Hudumika reads this account's Tuma customers read-only via GET /api/service/crm/customers.
# Must match crm.env's TUMA_SERVICE_KEY on the CRM side.
CRM_SERVICE_KEY=<openssl rand -hex 32>
