// Float transaction status types
type FloatTransactionStatus = "PAID" | "PENDING" | "FAILED"

// Helper function to detect if search query is a transaction ID
const isTransactionId = (query: string): boolean => {
    // Transaction IDs are typically specific patterns:
    // - TXN followed by digits
    // - AZM followed by mixed alphanumeric
    // - Long hexadecimal-like strings (32+ chars)
    // - Mixed numeric+letter strings (min 16 chars with both)
    const trimmed = query.trim()
    
    // Check for specific prefixes
    if (/^TXN\d+$/i.test(trimmed)) return true
    if (/^AZM\d+[a-f0-9]+$/i.test(trimmed)) return true
    
    // Check for long hex-like strings (16+ chars, mostly hex)
    if (trimmed.length >= 16 && /^[a-f0-9]+$/i.test(trimmed)) return true
    
    // Check for mixed numeric+alphanumeric (min 16 chars with both letters and numbers)
    if (trimmed.length >= 16 && /^[a-z0-9]+$/i.test(trimmed) && 
        /[a-f]/.test(trimmed) && /\d/.test(trimmed)) return true
        
    return false
}


