            try {
                const result = await getPaymentProviders()
                if (!result.success) {
                    // Failed to fetch from API, using mock data fallback
                    return mockProviders
                }
                return result.data || mockProviders
            } catch (error) {
                // Error fetching from API, using mock data fallback
                return mockProviders
            }
        },
        staleTime: 5 * 60 * 1000, // 5 minutes
        retry: 1,
    })

