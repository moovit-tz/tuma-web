    const { data: trendsData, isLoading: isLoadingTrends, refetch: refetchTrends } = useQuery({
        queryKey: ['float-transactions-trends', trendPeriod],
        queryFn: async () => {
            try {
                console.log('🔍 Fetching trends data for period:', trendPeriod)
                
                // Set different limits based on period
                const limitMap = {
                    daily: 30,    // Last 30 days
                    weekly: 12,   // Last 12 weeks
                    monthly: 12,  // Last 12 months
                    quarterly: 8  // Last 8 quarters
                }
                
                const result = await getFloatTransactionsTrends(trendPeriod, {
                    limit: limitMap[trendPeriod]
                })
                
                if (!result.success) {
                    console.log('⚠️ Trends API failed:', result.error)
                    // Don't use mock data, return null to show proper error state
                    return null
                }
                console.log('✅ Trends API success:', result.data)
                return result.data
            } catch (error) {
                console.log('❌ Trends API error:', error)
                // Don't use mock data, return null to show proper error state
                return null
            }
        },
        staleTime: 2 * 60 * 1000, // 2 minutes
        retry: 1,
    })

