DATABASE_URL=postgres://tuma:tuma@localhost:5544/tuma
SESSION_SECRET=change-me-32-bytes-min
ONDI_STUB_SECRET=change-me-32-bytes-min
# stub = /dev/ondi stand-in (development); oidc = ondi.hudumika.tz
ONDI_MODE=stub
APP_URL=http://localhost:3100
DATABASE_URL_TEST=postgres://tuma:tuma@localhost:5544/tuma_test

# Shared secret for Bliss case-update webhooks (/api/hooks/bliss). Leave empty to disable.
BLISS_WEBHOOK_SECRET=
# Bliss service routes for in-app support tickets (Help screen). Unset URL = stub (tickets kept in memory).
# e.g. https://bliss.hudumika.tz/v1 ; the key is Bliss's BLISS_SERVICE_KEY.
BLISS_API_URL=
BLISS_SERVICE_KEY=
# ComplyOS (KYB). stub = /dev/complyos stands in for the reviewer. Webhook: POST /api/hooks/complyos, HMAC-SHA256.
COMPLYOS_MODE=stub
COMPLYOS_WEBHOOK_SECRET=
# Company lookup (BRELA) through ComplyOS. Unset = the Hudumika registry lookup on Ondi (ONDI_API_URL).
COMPLYOS_API_URL=
COMPLYOS_API_TOKEN=
# Tuma's commission on parcels an agent handles, in basis points (placeholder: 1000 = 10%).
AGENT_COMMISSION_BPS=1000
# Real Ondi (ONDI_MODE=oidc): ondi-api base URL (discovery at /v1/oauth/.well-known/openid-configuration),
# and the Tuma client from POST /v1/clients/register on ondi-api.
ONDI_API_URL=https://ondi.hudumika.tz
# Ondi's web app (hosts /authorize). Same host in production.
ONDI_WEB_URL=https://ondi.hudumika.tz
ONDI_CLIENT_ID=
ONDI_CLIENT_SECRET=
# Claim that would carry Tuma role keys (Ondi doesn't send one today; Tuma grants roles itself).
ONDI_ROLES_CLAIM=roles

# Hudumika Reference Number Service (parcel, cargo and case numbers like AAB204).
# local = run the allocator in Tuma's own database (default, until the shared service is live)
# http  = call the shared service
REFERENCE_MODE=local
REFERENCE_API_URL=
REFERENCE_API_TOKEN=

# HuduBI (Hudumika analytics): Tuma pushes parcel-pricing snapshots for platform admins.
# e.g. https://api.hudumika.tz ; the key must match HUDUBI_INGEST_KEY on the moovit API. Unset = kept locally (stub).
HUDUBI_API_URL=
HUDUBI_INGEST_KEY=
# Hudumika HuduFeed (moovit-beta services/feed-api): sends Tuma's SMS, WhatsApp, email and app push (it holds the
# Firebase credentials). The key must match FEED_SERVICE_KEY there. Unset = kept locally (stub), nothing is sent.
HUDUFEED_URL=
HUDUFEED_SERVICE_KEY=
# Bearer token for scheduled jobs: POST /api/cron/pricing (hourly).
CRON_SECRET=
